# Postgres (only the password is sensitive — everything else can be public).
POSTGRES_DB=comicrealm
POSTGRES_USER=comicrealm
POSTGRES_PASSWORD=<strong-random-password>

# Full ADO.NET connection string. Written into Vault by `vault-seed`; the
# .NET backend only ever reads it from Vault, never from this file directly.
COMICREAL_DEFAULT_CONNECTION=Host=postgres;Port=5432;Database=comicrealm;Username=comicrealm;Password=<strong-random-password>

# JWT signing key (must be >=32 ASCII chars for HS256) + issuer/audience.
JWT_SIGNING_KEY=<at-least-32-random-chars>
JWT_ISSUER=ComicRealm
JWT_AUDIENCE=ComicRealm

# Local Vault dev-mode root token. Override per environment; never reuse in prod.
VAULT_DEV_ROOT_TOKEN_ID=<random-uuid>

# FE build-time API base URL baked into the static bundle.
VITE_API_BASE_URL=http://localhost:5053/api
