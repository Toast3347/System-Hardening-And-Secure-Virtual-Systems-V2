project          = "comicrealm"
environment      = "dev"

kubeconfig_path  = "~/.kube/config"
kube_context     = "minikube"

# Build inside the minikube docker daemon:
#   & minikube -p minikube docker-env --shell powershell | Invoke-Expression
#   docker build -t comicrealm-backend:local .\ComicRealmBE
backend_image     = "comicrealm-backend:local"
image_pull_policy = "IfNotPresent"

backend_node_port = 30053

postgres_admin_username = "comicrealm"
postgres_admin_password = "comicrealm"
postgres_database_name  = "comicrealm"
postgres_storage_size   = "2Gi"

jwt_signing_key = "dev-signing-key-change-me-please-32chars"

allowed_cors_origins = ["http://localhost:5173", "http://192.168.49.2:30173"]
