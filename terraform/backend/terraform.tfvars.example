project          = "comicrealm"
environment      = "dev"

kubeconfig_path  = "~/.kube/config"
kube_context     = "minikube"

# Build inside the minikube docker daemon:
#   & minikube -p minikube docker-env --shell powershell | Invoke-Expression
#   docker build -t comicrealm-backend:local .\ComicRealmBE
backend_image     = "comicrealm-backend:local"
image_pull_policy = "IfNotPresent"

backend_node_port = 30053

provider "vault" {
  address = "http://127.0.0.1:8200"
}

data "vault_kv_secret_v2" "secrets" {
  mount = "secret"
  name  = "comicrealm/dev"
}

postgres_admin_username = "comicrealm"
# DO NOT commit the password here. Inject it from your secret store:
#   $env:TF_VAR_postgres_admin_password = (vault kv get -field=postgres_admin_password secret/comicrealm)
# postgres_admin_password = "<set via TF_VAR_postgres_admin_password>"
postgres_database_name  = "comicrealm"
postgres_storage_size   = "2Gi"

# DO NOT commit the signing key here. Inject it from your secret store:
#   $env:TF_VAR_jwt_signing_key = (vault kv get -field=Jwt__SigningKey secret/comicrealm)
# jwt_signing_key = "<set via TF_VAR_jwt_signing_key>"

allowed_cors_origins = ["http://localhost:5173", "http://192.168.49.2:30173"]
